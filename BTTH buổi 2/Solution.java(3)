//Kiểm tra số nguyên tố
public class Solution {
  public static boolean isPrime(int n) {
    // Các số nhỏ hơn 2 không phải số nguyên tố
        if (n < 2) return false;

        // Kiểm tra chia hết cho các số từ 2 đến sqrt(n)
        for (int i = 2; i * i <= n; i++) {
            if (n % i == 0) {
                return false;
            }
        }

        return true;
  }
}
